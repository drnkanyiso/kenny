{
  "name": "dr-nkanyiso-site",
  "private": true,
  "scripts": {
    "start": "npm run css && hugo server --disableFastRender",
    "check:ui": "node scripts/check-ui.cjs",
    "css": "tailwindcss -i assets/css/tailwind.css -o assets/css/tailwind.generated.css --minify",
    "css:watch": "tailwindcss -i assets/css/tailwind.css -o assets/css/tailwind.generated.css --watch",
    "build": "npm run css && hugo --gc --minify --cleanDestinationDir"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.0"
  }
}
